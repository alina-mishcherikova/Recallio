# Local development only. Copy to `.env` and change the passwords.
# Never commit real secrets. Production values come from the hosting provider's secret store.
# Changing a password or role here needs a fresh volume: `pnpm db:reset` (deletes local data).

# PostgreSQL (docker compose). Bootstrap superuser, local only: never used by the app or migrations.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=recallio
POSTGRES_PORT=5432

# Roles created by docker/postgres/initdb/10-roles.sh on first start
RECALLIO_MIGRATOR_PASSWORD=change-me-locally-migrator
RECALLIO_APP_PASSWORD=change-me-locally-app

# Runtime connection: the app role (DML only). A built server refuses to start with a role that can
# run DDL. Non-local DBs in built servers need ?sslmode=verify-full
NUXT_DATABASE_URL=postgres://recallio_app:change-me-locally-app@localhost:5432/recallio

# Migrations only (drizzle-kit, test setup). Never read by the Nuxt server.
DATABASE_MIGRATOR_URL=postgres://recallio_migrator:change-me-locally-migrator@localhost:5432/recallio

# Integration tests (`pnpm test:integration`). The database name must end in _test: it is wiped on every run.
TEST_DATABASE_URL=postgres://recallio_app:change-me-locally-app@localhost:5432/recallio_test
TEST_DATABASE_MIGRATOR_URL=postgres://recallio_migrator:change-me-locally-migrator@localhost:5432/recallio_test

# Optional: header set by your reverse proxy with the real client IP (e.g. fly-client-ip)
NUXT_TRUSTED_IP_HEADER=
