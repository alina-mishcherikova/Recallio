# Local development only. Copy to `.env` and change the password.
# Never commit real secrets. Production values come from the hosting provider's secret store.

# PostgreSQL (docker compose)
POSTGRES_USER=recallio
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=recallio
POSTGRES_PORT=5432

# App connection string. Non-local DBs in built servers need ?sslmode=verify-full
NUXT_DATABASE_URL=postgres://recallio:change-me-locally@localhost:5432/recallio

# Optional: header set by your reverse proxy with the real client IP (e.g. fly-client-ip)
NUXT_TRUSTED_IP_HEADER=
